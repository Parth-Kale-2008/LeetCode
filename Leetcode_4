class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int n = nums2.length;

        int arr[] = new int[m+n];
        int k = 0;

        for(int i=0;i<m;i++) arr[k++] = nums1[i];
        for(int i=0;i<n;i++) arr[k++] = nums2[i];

        for(int i=0;i< arr.length-1;i++){
            for(int j=0;j<arr.length-i-1;j++){
                if(arr[j]>arr[j+1]){
                    int temp = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = temp;
                }
            }
        }
       int len = arr.length;

if (len % 2 == 1) {
    return arr[len / 2];
} else {
    return (arr[len / 2] + arr[len / 2 - 1]) / 2.0;
}
    }
}